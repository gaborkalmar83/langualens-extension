{
  "manifest_version": 3,
  "name": "LanguaLens",
  "version": "2.0.0",
  "description": "Read a page in the language you are learning with the translation underneath. Translates on device, saves words for Anki.",
  "minimum_chrome_version": "138",
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LanguaLens",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["languages.js", "translator.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "translate-page": {
      "suggested_key": { "default": "Alt+L" },
      "description": "Translate the current page"
    }
  }
}
